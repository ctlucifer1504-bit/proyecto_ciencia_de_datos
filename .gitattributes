# Normaliza los finales de línea para que el repositorio sea consistente en Windows,
# Linux y macOS. Los archivos binarios no se tocan.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.zip   binary
